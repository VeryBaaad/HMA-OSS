<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="PackageVisibilityPolicy,QueryAllPackagesPermission" />

    <application
        android:name="icu.nullptr.hidemyapplist.MyApp"
        android:allowBackup="true"
        android:fullBackupOnly="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:theme="@style/AppTheme"
        tools:targetApi="33">

        <activity
            android:name="org.frknkrc44.hma_oss.ui.activity.MainActivity"
            android:exported="true"
            android:configChanges="assetsPaths|colorMode|density|fontScale|fontWeightAdjustment|grammaticalGender|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|resourcesUnused|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".MainActivityLauncher"
            android:exported="true"
            android:targetActivity="org.frknkrc44.hma_oss.ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityLauncherAlt"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_alt"
            android:targetActivity="org.frknkrc44.hma_oss.ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityLauncherAlt2"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_alt_2"
            android:targetActivity="org.frknkrc44.hma_oss.ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityLauncherAlt3"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_alt_3"
            android:targetActivity="org.frknkrc44.hma_oss.ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityLauncherAlt4"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_alt_5"
            android:targetActivity="org.frknkrc44.hma_oss.ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="icu.nullptr.hidemyapplist.service.ServiceProvider"
            android:authorities="${applicationId}.ServiceProvider"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!--
          The Modern Xposed (libxposed) service bridge is contributed by the
          io.github.libxposed:service artifact: it declares
          io.github.libxposed.service.XposedProvider with the authority
          "${applicationId}.XposedService". The framework sends its IXposedService
          binder there, which lets the manager query the framework and trigger a hot
          reload. It must NOT be redeclared here or the manifest merger conflicts.
        -->

        <!--
          Legacy `xposedmodule` / `xposedscope` metadata is intentionally gone: the
          module is described by META-INF/xposed/module.prop, java_init.list and
          scope.list, which the Modern Xposed framework reads from the APK.
        -->
    </application>
</manifest>
